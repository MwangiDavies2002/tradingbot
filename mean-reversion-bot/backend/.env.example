# ── App ───────────────────────────────────────────────────────
APP_NAME=Mean Reversion Bot
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Deriv API ─────────────────────────────────────────────────
# Get app_id from: https://api.deriv.com/
# Get token from:  https://app.deriv.com/account/api-token
DERIV_APP_ID=your_app_id_here
DERIV_API_TOKEN=your_api_token_here
DERIV_DEMO=True

# ── Database ──────────────────────────────────────────────────
# Use Supabase's Session Pooler URL in Vercel. Keep the +asyncpg driver prefix.
# Example: postgresql+asyncpg://postgres.<project-ref>:password@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# Comma-separated JSON list. Add your Vercel URL after the first deployment.
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","https://your-project.vercel.app"]

# ── Security ──────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_64_char_random_hex_string

# ── Trading Risk ──────────────────────────────────────────────
RISK_PCT=0.01
MAX_RISK_PCT=0.02
MAX_OPEN_POSITIONS=3
SL_ATR_MULTIPLIER=1.5
TP_RR_RATIO=2.0
MIN_CONFLUENCE_SCORE=6
DERIV_MULTIPLIER=100
DERIV_PRODUCT=multiplier

# ── Active Instruments ────────────────────────────────────────
ACTIVE_SYMBOLS=["R_75"]
PRIMARY_TIMEFRAME=300
HTF_TIMEFRAME=3600

# ── Alerts (optional) ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Sentry (optional) ─────────────────────────────────────────
SENTRY_DSN=
